{
  "name": "santa-dice",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "backend": "docker compose -f docker-compose.dev.yml up",
    "backend:reset": "docker compose -f docker-compose.dev.yml down -v",
    "backend:seed": "docker compose -f docker-compose.dev.yml exec -T api sh -c \"rm -rf /data/uploads /data/*.json /data/*.migrated && mkdir -p /data/uploads && cat > /data/data.json\" < dev/seed.json && docker compose -f docker-compose.dev.yml cp dev/uploads/. api:/data/uploads/ && docker compose -f docker-compose.dev.yml exec -T api chown -R www-data:www-data /data",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng build && playwright test",
    "postinstall": "ngcc"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~15.2.5",
    "@angular/cdk": "~15.2.5",
    "@angular/common": "~15.2.5",
    "@angular/compiler": "~15.2.5",
    "@angular/core": "~15.2.5",
    "@angular/forms": "~15.2.5",
    "@angular/material": "~15.2.5",
    "@angular/platform-browser": "~15.2.5",
    "@angular/platform-browser-dynamic": "~15.2.5",
    "@angular/router": "~15.2.5",
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "rxjs": "^7.4.0",
    "tslib": "^2.0.0",
    "zone.js": "~0.13.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~15.2.4",
    "@angular/cli": "~15.2.4",
    "@angular/compiler-cli": "~15.2.5",
    "@angular/language-service": "~15.2.5",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~4.3.1",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "~18.15.11",
    "tslint": "~6.1.0",
    "typescript": "~4.8.2"
  }
}
